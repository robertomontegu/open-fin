# Use `make setup` to create .env with generated secrets and mode 0600.
# Never put real bank credentials in this file or .env.
OPEN_FIN_API_TOKEN=
OPEN_FIN_ENCRYPTION_KEY=
OPEN_FIN_DATABASE_PATH=/data/open-fin.db
OPEN_FIN_MODE=demo
OPEN_FIN_COOLDOWN_SECONDS=3600
OPEN_FIN_JOB_TIMEOUT_SECONDS=240
OPEN_FIN_HEADLESS=true
OPEN_FIN_PORT=8088
OPEN_FIN_SOURCE_URL=https://github.com/robertomontegu/open-fin
